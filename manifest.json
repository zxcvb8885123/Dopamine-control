{
  "manifest_version": 3,
  "name": "FocusFlow Pro (去刺激化模組)",
  "version": "1.0.0",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/declutter.js",
        "content/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup/popup-controller.html"
  }
}